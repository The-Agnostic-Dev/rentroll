<section class="card narrow">
  <h1>Rentroll</h1>
  <p class="muted">Sign in to manage rents, tenants and receipts.</p>
  <%= form_with url: session_path do |form| %>
    <div class="field">
      <%= form.label :email %>
      <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username", value: params[:email] %>
    </div>
    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password, required: true, autocomplete: "current-password" %>
    </div>
    <%= form.submit "Sign in", class: "button" %>
  <% end %>
</section>
